<!DOCTYPE html>
<html lang="en">

{{> "head" }}

<body>

{{> "overlayNoise" }}

{{> "adLhs" }}
{{> "adRhs" }}

<div class="viewport-wrapper ve-print__overflow-visible">
	{{> "adLeaderboard" }}

	{{> "navbar" }}

	<div class="ve-h-100 ve-flex-col ve-min-h-0 ve-print__h-initial" data-cancer-id="cancer-wrapper">
		<div class="ve-pt-2 ve-mb-1 ve-pl-7p ve-pr-7p ve-flex-v-center ve-mobile-md__flex-col ve-mobile-md__flex-ai-start ve-print__hidden">
			<div class="ve-flex-v-stretch ve-mr-2 ve-mobile-md__mr-0 ve-mobile-md__mb-2" id="wrp-sel-renderer">
				<div class="ve-mr-2 ve-bold ve-flex-v-center">Renderer</div>
			</div>

			<div class="ve-flex-v-stretch ve-mobile-md__flex-col ve-mobile-md__flex-ai-start" id="wrp-settings"></div>
		</div>

		<div class="ve-flex ve-h-100 ve-min-h-0 ve-mobile-md__flex-col ve-mobile-md__h-initial ve-mobile-md__min-h-initial ve-mobile-md__flex-col ve-print__h-initial">
			<div class="view-col ve-print__hidden">
				<div class="ve-mb-2 ve-split-v-center ve-w-100">
					<h4 class="ve-my-0 ve-italic">Input</h4>

					<button class="ve-btn ve-btn-default ve-btn-xs" id="btn-format">Format</button>
				</div>

				<pre id="jsoninput" class="ve-h-100 ve-mb-0 ace_editor"></pre>
			</div>

			<div class="view-col ve-print__h-initial ve-print__m-0">
				<div class="ve-mb-2 ve-split-v-center ve-w-100 ve-print__hidden">
					<div class="ve-flex-v-center">
						<h4 class="ve-my-0 ve-italic">Output</h4>
					</div>

					<div class="ve-flex-v-center ve-mobile-xs__flex-col ve-mobile-xs__flex-ai-start">
						<!-- (Space for future controls) -->
					</div>
				</div>

				<div class="ve-min-h-0 ve-overflow-auto ve-print__overflow-visible">
					<table id="pagecontent" class="ve-w-100 ve-stats">
						<!-- populate with JS -->
					</table>
				</div>

				<div class="ve-mt-2 ve-p-2 ve-hidden ve-no-shrink alert alert-danger ve-print__hidden" id="disp-errors"></div>
			</div>
		</div>
	</div>
</div>

{{> "adFooter" }}

{{> "scripts" }}

</body>
</html>
